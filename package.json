{
  "name": "myucla-workspace",
  "version": "0.19.5",
  "private": true,
  "description": "A customizable workspace for browsing courses and planning schedules inside MyUCLA.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "harness": "node harness/run.mjs",
    "test:search-layout": "node harness/verify-native-search-layout.mjs",
    "test:result-layout": "node harness/verify-native-result-layout.mjs",
    "test:empty-plan": "node harness/verify-empty-plan-workspace.mjs",
    "test:details": "node harness/verify-native-detail-layout.mjs",
    "test:optimizer": "node harness/verify-optimizer-workspace.mjs",
    "test:plan-actions": "node harness/verify-plan-actions.mjs",
    "test:module-controls": "node harness/verify-module-controls.mjs",
    "test:finals-controls": "node harness/verify-finals-controls.mjs",
    "test:course-controls": "node harness/verify-course-controls.mjs",
    "test:course-detail-actions": "node harness/verify-course-detail-actions.mjs",
    "test:panel-layout": "node harness/verify-panel-layout.mjs",
    "test:workspace-groups": "node harness/verify-workspace-groups.mjs",
    "test:workspace-settings": "node harness/verify-workspace-settings.mjs",
    "test:workspace-splits": "node harness/verify-workspace-split-regressions.mjs",
    "test:v019-calendar": "node harness/verify-v019-calendar.mjs",
    "test:v019-courses": "node harness/verify-v019-course-polish.mjs",
    "test:dark-mode": "node harness/verify-dark-mode.mjs",
    "test:header-reveal": "node harness/verify-header-reveal.mjs",
    "test:calendar-gridlines": "node harness/verify-calendar-gridlines.mjs",
    "preview:build": "node scripts/build-preview.mjs",
    "preview:verify": "node harness/verify-preview.mjs",
    "icons:build": "node scripts/build-icons.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.326",
    "esbuild": "^0.25.9",
    "jsdom": "^26.1.0",
    "playwright": "^1.56.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/comet-ctrl/myucla-workspace.git"
  },
  "license": "MIT",
  "author": "comet-ctrl",
  "homepage": "https://github.com/comet-ctrl/myucla-workspace#readme",
  "bugs": {
    "url": "https://github.com/comet-ctrl/myucla-workspace/issues"
  }
}
