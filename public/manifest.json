{
  "manifest_version": 3,
  "name": "MyUCLA Workspace",
  "version": "0.19.5",
  "version_name": "0.19.5 development — MyUCLA Workspace",
  "description": "An unofficial, customizable workspace for UCLA Class Planner. Browse courses, arrange panels and keep your schedule in view.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "MyUCLA Workspace",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://be.my.ucla.edu/ClassPlanner/ClassPlan.aspx"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "injected.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://be.my.ucla.edu/ClassPlanner/ClassPlan.aspx"
      ],
      "js": [
        "page-bridge.js"
      ],
      "run_at": "document_end",
      "world": "MAIN"
    }
  ],
  "homepage_url": "https://github.com/comet-ctrl/myucla-workspace"
}
